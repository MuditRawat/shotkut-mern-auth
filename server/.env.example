# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Database URI
# Replace with your actual MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mern_auth?retryWrites=true&w=majority

# JWT Token Configuration
ACCESS_TOKEN_SECRET=replace_with_your_access_token_secret_min_32_chars
REFRESH_TOKEN_SECRET=replace_with_your_refresh_token_secret_min_32_chars
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d
